import React, { useState, useEffect } from 'react';
import { 
  Users, 
  UserPlus, 
  Trash2, 
  Bell, 
  Calendar, 
  BookOpen, 
  Award, 
  Search, 
  Globe, 
  CheckCircle,
  Clock,
  Sparkles,
  Heart
} from 'lucide-react';

export default function App() {
  // 탭 상태
  const [activeTab, setActiveTab] = useState('home');

  // 학생 명단 상태
  const [students, setStudents] = useState([
    { id: 1, number: 1, name: '강민준', role: '반장', points: 15, memo: '밝고 활발함' },
    { id: 2, number: 2, name: '김서연', role: '부반장', points: 12, memo: '책임감이 강함' },
    { id: 3, number: 3, name: '박도윤', role: '미백부장', points: 8, memo: '그림을 잘 그림' },
    { id: 4, number: 4, name: '이지우', role: '학생', points: 10, memo: '발표를 잘함' },
    { id: 5, number: 5, name: '최현우', role: '학생', points: 5, memo: '운동을 좋아함' }
  ]);

  // 학생 추가 폼 상태
  const [newNum, setNewNum] = useState('');
  const [newName, setNewName] = useState('');
  const [newRole, setNewRole] = useState('학생');
  const [newMemo, setNewMemo] = useState('');

  // 검색어 상태
  const [searchTerm, setSearchTerm] = useState('');

  // 공지사항 상태
  const [notices, setNotices] = useState([
    { id: 1, title: '다음 주 금요일 현장체험학습 안내', date: '2026-11-05', author: '담임선생님', important: true },
    { id: 2, title: '학급 규칙 및 청소 구역 안내', date: '2026-11-02', author: '반장', important: false },
    { id: 3, title: '동아리 활동 신청 마감일 안내', date: '2026-10-28', author: '담임선생님', important: false }
  ]);

  // 새 공지사항 폼 상태
  const [noticeTitle, setNoticeTitle] = useState('');
  const [noticeImportant, setNoticeImportant] = useState(false);

  // 학생 추가 함수
  const handleAddStudent = (e) => {
    e.preventDefault();
    if (!newName.trim()) return;

    const nextId = students.length > 0 ? Math.max(...students.map(s => s.id)) + 1 : 1;
    const num = newNum ? parseInt(newNum) : (students.length + 1);

    const newStudent = {
      id: nextId,
      number: num,
      name: newName.trim(),
      role: newRole,
      points: 0,
      memo: newMemo.trim() || '신규 학생'
    };

    setStudents([...students, newStudent].sort((a, b) => a.number - b.number));
    
    // Reset Form
    setNewNum('');
    setNewName('');
    setNewRole('학생');
    setNewMemo('');
  };

  // 학생 삭제 함수
  const handleDeleteStudent = (id) => {
    setStudents(students.filter(s => s.id !== id));
  };

  // 상점 부여 함수
  const handleAddPoint = (id) => {
    setStudents(students.map(s => s.id === id ? { ...s, points: s.points + 1 } : s));
  };

  // 공지사항 추가 함수
  const handleAddNotice = (e) => {
    e.preventDefault();
    if (!noticeTitle.trim()) return;

    const today = new Date().toISOString().split('T')[0];
    const newEntry = {
      id: Date.now(),
      title: noticeTitle.trim(),
      date: today,
      author: '담임선생님',
      important: noticeImportant
    };

    setNotices([newEntry, ...notices]);
    setNoticeTitle('');
    setNoticeImportant(false);
  };

  // 필터링된 학생 명단
  const filteredStudents = students.filter(s => 
    s.name.includes(searchTerm) || s.number.toString().includes(searchTerm) || s.role.includes(searchTerm)
  );

  // 주간 시간표 데이터
  const timetable = [
    { period: '1교시', mon: '국어', tue: '수학', wed: '영어', thu: '과학', fri: '사회' },
    { period: '2교시', mon: '수학', tue: '영어', wed: '국어', thu: '체육', fri: '음악' },
    { period: '3교시', mon: '영어', tue: '과학', wed: '사회', thu: '국어', fri: '미술' },
    { period: '4교시', mon: '과학', tue: '사회', wed: '체육', thu: '수학', fri: '도덕' },
    { period: '5교시', mon: '체육', tue: '음악', wed: '동아리', thu: '영어', fri: '진로' },
    { period: '6교시', mon: '사회', tue: '미술', wed: '동아리', thu: '국어', fri: '학급회의' },
  ];

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans">
      {/* 주소 표시 브라우저 바 (요청된 주소 강조) */}
      <div className="bg-slate-900 text-slate-300 px-4 py-2.5 flex items-center gap-3 text-sm shadow-inner">
        <div className="flex gap-1.5">
          <div className="w-3 h-3 rounded-full bg-red-500"></div>
          <div className="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div className="w-3 h-3 rounded-full bg-green-500"></div>
        </div>
        <div className="flex-1 bg-slate-800 rounded-md px-3 py-1 flex items-center gap-2 max-w-xl text-xs sm:text-sm text-slate-200">
          <Globe className="w-4 h-4 text-emerald-400 shrink-0" />
          <span className="font-mono text-emerald-400">https://</span>
          <span className="font-mono font-semibold text-white">www.1stforth.com</span>
        </div>
        <span className="text-xs bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 px-2 py-0.5 rounded hidden sm:inline-block">
          1학년 4반 공식 학급 웹사이트
        </span>
      </div>

      {/* 내비게이션 헤더 */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-10 shadow-sm">
        <div className="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white font-bold text-lg shadow-md shadow-indigo-200">
              1-4
            </div>
            <div>
              <h1 className="text-xl font-bold text-slate-900 leading-tight">1학년 4반 학급 홈페이지</h1>
              <p className="text-xs text-slate-500">꿈과 희망이 커가는 포근한 우리 교실 🌟</p>
            </div>
          </div>

          {/* 탭 버튼 메뉴 */}
          <nav className="flex bg-slate-100 p-1 rounded-xl gap-1 w-full sm:w-auto overflow-x-auto">
            <button
              onClick={() => setActiveTab('home')}
              className={`flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap ${
                activeTab === 'home'
                  ? 'bg-white text-indigo-600 shadow-sm'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
              }`}
            >
              <Bell className="w-4 h-4" /> 홈 & 공지
            </button>
            <button
              onClick={() => setActiveTab('students')}
              className={`flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap ${
                activeTab === 'students'
                  ? 'bg-white text-indigo-600 shadow-sm'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
              }`}
            >
              <Users className="w-4 h-4" /> 학생 명단 ({students.length}명)
            </button>
            <button
              onClick={() => setActiveTab('timetable')}
              className={`flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all whitespace-nowrap ${
                activeTab === 'timetable'
                  ? 'bg-white text-indigo-600 shadow-sm'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
