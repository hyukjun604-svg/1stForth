            {/* 좌측 메인 섹션 */}
            <div className="lg:col-span-2 space-y-6">
              {/* 학급 소개 배너 */}
              <div className="bg-gradient-to-br from-indigo-600 via-indigo-700 to-purple-800 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
                <div className="absolute top-0 right-0 transform translate-x-4 -translate-y-4 opacity-10">
