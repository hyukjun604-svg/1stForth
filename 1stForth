                      <Users className="w-4 h-4 text-indigo-200" />
                      <span>총 학생 수: <strong>{students.length}명</strong></span>
                    </div>
                    <div className="bg-white/10 backdrop-blur-md px-3 py-2 rounded-lg border border-white/10 flex items-center gap-2">
                      <Heart className="w-4 h-4 text-pink-300" />
                      <span>학급 급훈: <strong>더불어 함께 성장하자</strong></span>
                    </div>
                  </div>
                </div>
              </div>

              {/* 공지사항 목록 */}
              <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <div className="flex justify-between items-center mb-6">
                  <h3 className="text-lg font-bold text-slate-900 flex items-center gap-2">
                    <Bell className="w-5 h-5 text-indigo-600" /> 학급 알림장 및 공지
                  </h3>
                  <span className="text-xs text-slate-500">총 {notices.length}건</span>
                </div>

                {/* 공지 등록 폼 */}
                <form onSubmit={handleAddNotice} className="mb-6 bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <div className="flex flex-col sm:flex-row gap-3">
                    <input
                      type="text"
                      placeholder="새 알림장 소식을 입력하세요..."
                      value={noticeTitle}
                      onChange={(e) => setNoticeTitle(e.target.value)}
                      className="flex-1 px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    />
                    <label className="flex items-center gap-2 text-xs text-slate-600 cursor-pointer select-none px-1">
                      <input
                        type="checkbox"
                        checked={noticeImportant}
                        onChange={(e) => setNoticeImportant(e.target.checked)}
                        className="rounded text-indigo-600 focus:ring-indigo-500"
                      />
                      <span>중요 알림</span>
                    </label>
                    <button
                      type="submit"
                      className="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition"
                    >
                      등록
                    </button>
                  </div>
                </form>

                {/* 공지 리스트 */}
                <div className="space-y-3">
                  {notices.map((notice) => (
                    <div 
                      key={notice.id}
                      className={`p-4 rounded-xl border transition-all flex justify-between items-center ${
                        notice.important 
                          ? 'bg-amber-50/60 border-amber-200 text-amber-950' 
                          : 'bg-white border-slate-100 hover:border-slate-200 text-slate-800'
                      }`}
                    >
                      <div className="flex items-start gap-3">
                        {notice.important ? (
                          <span className="bg-amber-500 text-white text-[10px] px-2 py-0.5 rounded font-bold mt-0.5 shrink-0">
                            중요
                          </span>
                        ) : (
                          <span className="bg-slate-200 text-slate-600 text-[10px] px-2 py-0.5 rounded font-medium mt-0.5 shrink-0">
                            일반
                          </span>
                        )}
                        <div>
                          <p className="font-semibold text-sm sm:text-base">{notice.title}</p>
                          <div className="flex gap-3 text-xs text-slate-400 mt-1">
                            <span>작성자: {notice.author}</span>
                            <span>•</span>
                            <span>{notice.date}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* 우측 사이드바 */}
            <div className="space-y-6">
              {/* 반장/부반장 스포트라이트 */}
              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <h3 className="text-md font-bold text-slate-900 mb-4 flex items-center gap-2">
                  <Award className="w-5 h-5 text-amber-500" /> 학급 임원진
                </h3>
                <div className="space-y-3">
                  {students.filter(s => s.role.includes('반장')).map((leader) => (
                    <div key={leader.id} className="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-100">
                      <div className="flex items-center gap-3">
                        <div className="w-8 h-8 rounded-full bg-amber-100 text-amber-700 font-bold flex items-center justify-center text-xs">
                          {leader.number}
                        </div>
                        <div>
                          <p className="font-bold text-sm text-slate-800">{leader.name}</p>
                          <p className="text-xs text-indigo-600 font-medium">{leader.role}</p>
                        </div>
                      </div>
                      <span className="text-xs bg-amber-100 text-amber-800 px-2 py-1 rounded-full font-medium">
                        칭찬 {leader.points}회
                      </span>
                    </div>
                  ))}
                  {students.filter(s => s.role.includes('반장')).length === 0 && (
                    <p className="text-xs text-slate-400 text-center py-2">등록된 학급 임원이 없습니다.</p>
                  )}
                </div>
              </div>

              {/* 오늘 급식 안내 간이 카드 */}
              <div className="bg-gradient-to-br from-emerald-500 to-teal-600 text-white p-5 rounded-2xl shadow-sm">
                <div className="flex justify-between items-center mb-3">
                  <h3 className="font-bold text-md flex items-center gap-2">
                    <BookOpen className="w-5 h-5" /> 오늘의 급식
                  </h3>
                  <span className="text-xs bg-white/20 px-2 py-0.5 rounded text-white">중식</span>
                </div>
                <ul className="text-xs sm:text-sm space-y-1.5 text-emerald-50">
                  <li>• 발아현미밥</li>
